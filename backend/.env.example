# Copy to backend/.env.local and fill in. That file is gitignored.

# --- LiveKit (required) -------------------------------------------------------------
# Option A, no account: a local server. `brew install livekit`; `make dev` starts it.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Option B: a free LiveKit Cloud project (cloud.livekit.io -> project settings -> API keys).
# On Cloud, any stage without its own key below runs on LiveKit Inference, and LiveKit's
# cloud turn detector is used.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# --- Model providers -------------------------------------------------------------------
# Every provider with a key joins its stage's chain, in this order; the first serves and
# the rest take over if it fails.
# Speech-to-text:  Deepgram
# LLM:             Anthropic (Claude) -> OpenAI -> Google (Gemini)
# Voice:           Deepgram (Aura) -> ElevenLabs -> OpenAI
# ElevenLabs' free plan serves only default voices (e.g. Sarah, EXAVITQu4vr4xnSDxMaL) via the API.
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=

# --- Optional overrides ---------------------------------------------------------------
# SLIDEPILOT_LLM_PROVIDER=openai      # anthropic | openai | google | livekit
# SLIDEPILOT_LLM_MODEL=gpt-4.1-mini   # defaults: claude-opus-5-5, gpt-4.1, gemini-2.5-flash
# SLIDEPILOT_LLM_EFFORT=low           # Claude effort: low | medium | high
# SLIDEPILOT_STT_PROVIDER=deepgram    # deepgram | livekit
# SLIDEPILOT_TTS_PROVIDER=openai      # elevenlabs | deepgram | openai | livekit
# SLIDEPILOT_TTS_MODEL=aura-2-asteria-en
# SLIDEPILOT_TTS_VOICE=coral          # OpenAI voice name or ElevenLabs voice ID
# SLIDEPILOT_CORS_ORIGINS=http://localhost:5173
# SLIDEPILOT_AGENT_NAME=slidepilot-presenter   # give a second stack its own name to share a LiveKit server
